# Variáveis do site. Copie para `.env.local` para rodar localmente; na Vercel,
# defina em Settings > Environment Variables (produção e preview). Nenhum valor
# real entra no repositório.

# Lead do diagnóstico → n8n (docs/n8n/LEIA-ME.md). Sem elas o formulário
# responde "envio em configuração".
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Medição no navegador (src/lib/medicao.ts). Sem o ID, a ferramenta não carrega.
# GA4: ID de métricas da propriedade, formato G-XXXXXXXXXX.
NEXT_PUBLIC_GA4_ID=
# Pixel da Meta: só quando houver campanha ativa na Meta (plano, seção 7.2).
NEXT_PUBLIC_META_PIXEL_ID=

# API de Conversões da Meta, pelo servidor (src/lib/capi.ts). O mesmo ID do
# Pixel e um token de sistema com permissão de anúncios; o código de teste
# (Gerenciador de Eventos > Testar eventos) só enquanto se confere o envio.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAPI_TEST_CODE=
