      "notes": "Webhook da conta 1 no Chatwoot (Settings, Integrations, Webhooks), só a caixa 12, evento message_created."
    },
    {
      "id": "fb0256c4-e108-55da-8260-3696a85503ad",
      "name": "Configuração",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
