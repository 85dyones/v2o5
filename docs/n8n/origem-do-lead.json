        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ custom_attributes: $('Decidir').first().json.atributos }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Chatwoot · api_access_token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "552b9efd-a04b-5121-852d-e59aaf00eaa7",
