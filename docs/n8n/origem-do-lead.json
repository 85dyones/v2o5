    {
      "id": "036975e7-da4f-55bd-93a2-8cd786284f9a",
      "name": "Mensagem recebida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "// Só interessa mensagem que o contato mandou na caixa do WhatsApp da V2O5.\n// O endereço do webhook é público: o resto do fluxo relê tudo pela API do\n// Chatwoot e usa daqui só os números (conversa, contato, mensagem).\nconst cfg = $(\"Configuração\").first().json;\nconst evento = $input.first().json.body || {};\nconst conversa = evento.conversation || {};\nconst recebida = evento.message_type === \"incoming\" || evento.message_type === 0;\nconst daConta = String(evento.account?.id) === String(cfg.chatwootConta);\nconst daCaixa = String(conversa.inbox_id ?? evento.inbox?.id) === String(cfg.chatwootInbox);\nconst contatoId = conversa.meta?.sender?.id ?? evento.sender?.id;\nif (evento.event !== \"message_created\" || !recebida || evento.private || !daConta || !daCaixa || !conversa.id || !contatoId) return [];\nreturn [{\n  json: {\n    conversaId: conversa.id,\n    contatoId,\n    mensagemId: evento.id,\n    texto: String(evento.content ?? \"\"),\n    rotulosDaConversa: Array.isArray(conversa.labels) ? conversa.labels : [],\n  },\n}];\n"
      }
    },
    {
      "id": "91cc679d-1f15-529b-8f7a-f3bc06f9beec",
      "name": "Contato",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuração').first().json.chatwootUrl }}/api/v1/accounts/{{ $('Configuração').first().json.chatwootConta }}/contacts/{{ $json.contatoId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Chatwoot · api_access_token"
        }
      },
      "onError": "stopWorkflow"
    },
    {
      "id": "91eddebe-c5c6-510b-8808-bf658c295765",
      "name": "Mensagens da conversa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuração').first().json.chatwootUrl }}/api/v1/accounts/{{ $('Configuração').first().json.chatwootConta }}/conversations/{{ $('Mensagem recebida').first().json.conversaId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Chatwoot · api_access_token"
        }
      },
      "onError": "stopWorkflow"
    },
    {
      "id": "1293977a-0622-5b0b-b50b-c5ca027334c4",
      "name": "Decidir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "// Lead do botão de WhatsApp: toda mensagem pronta do site traz \"site da\n// V2O5\" (MARCA_DO_SITE em src/conteudo/home.ts). Primeira mensagem recebida\n// da conversa com esse trecho marca o contato. Contato já marcado só ganha a\n// etiqueta na conversa nova.\nconst cfg = $(\"Configuração\").first().json;\nconst ev = $(\"Mensagem recebida\").first().json;\nconst contato = $(\"Contato\").first().json.payload || {};\nconst lista = $(\"Mensagens da conversa\").first().json;\nconst mensagens = Array.isArray(lista.payload) ? lista.payload : [];\nconst semAcento = (t) => String(t ?? \"\").normalize(\"NFD\").replace(/[̀-ͯ]/g, \"\").toLowerCase().replace(/\\s+/g, \" \").trim();\nconst recebida = (m) => (m.message_type === 0 || m.message_type === \"incoming\") && !m.private;\n\n// Texto e dono da conversa vêm da API, não do evento: o endereço do webhook\n// é público e um evento forjado não pode marcar contato nenhum.\nconst atual = mensagens.find((m) => Number(m.id) === Number(ev.mensagemId) && recebida(m));\nif (!atual || String(atual.inbox_id) !== String(cfg.chatwootInbox) || Number(lista.meta?.contact?.id) !== Number(ev.contatoId)) return [];\nconst primeira = mensagens.filter(recebida).every((m) => Number(m.id) >= Number(atual.id));\nconst temMarca = semAcento(atual.content).includes(semAcento(cfg.marcaDoSite));\nconst jaMarcado = semAcento((contato.custom_attributes || {})[cfg.atributoOrigem]) === semAcento(cfg.valorOrigem);\nconst marcarContato = !jaMarcado && primeira && temMarca;\nconst rotulos = Array.isArray(lista.meta?.labels) ? lista.meta.labels : ev.rotulosDaConversa;\nconst etiquetarConversa = (jaMarcado || marcarContato) && !rotulos.includes(cfg.etiquetaOrigem);\nif (!marcarContato && !etiquetarConversa) return [];\nreturn [{\n  json: {\n    contatoId: ev.contatoId,\n    conversaId: ev.conversaId,\n    marcarContato,\n    etiquetarConversa,\n    rotulosDaConversa: [...new Set([...rotulos, cfg.etiquetaOrigem])],\n    atributos: { [cfg.atributoOrigem]: cfg.valorOrigem, entrada: \"botão de WhatsApp do site\", primeira_mensagem: String(atual.content ?? \"\").slice(0, 300) },\n  },\n}];\n"
      }
    },
    {
      "id": "57b554a4-8d36-5763-9080-e54c67ce865b",
      "name": "Marcar contato?",
      "type": "n8n-nodes-base.if",
