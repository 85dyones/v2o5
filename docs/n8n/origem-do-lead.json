    {
      "id": "9fb302a1-b995-5640-b0db-b0f49f2aacae",
      "name": "Somar etiqueta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        100
      ],
      "parameters": {
        "jsCode": "// A API troca a lista inteira de etiquetas: soma a da origem às que já existem.\nconst cfg = $(\"Configuração\").first().json;\nconst atuais = Array.isArray($input.first().json.payload) ? $input.first().json.payload : [];\nreturn [{ json: { labels: [...new Set([...atuais, cfg.etiquetaOrigem])] } }];\n"
      }
    },
    {
      "id": "19e7ade1-2bbf-56e4-9cf5-f9202ea85098",
      "name": "Etiquetar contato",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuração').first().json.chatwootUrl }}/api/v1/accounts/{{ $('Configuração').first().json.chatwootConta }}/contacts/{{ $('Decidir').first().json.contatoId }}/labels",
        "authentication": "genericCredentialType",
