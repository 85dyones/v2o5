    {
      "parameters": {
        "jsCode": "// Monta, a partir do POST de /api/leads, os textos do aviso e da resposta.\nconst ROTULOS = {\"segmento\":{\"automotivo\":\"Revenda de veículos\",\"servicos\":\"Serviços\",\"comercio\":\"Comércio\",\"imobiliario\":\"Imobiliário\",\"saude\":\"Saúde\",\"industria\":\"Indústria\",\"outro\":\"Outro\"},\"porte\":{\"1\":\"Só eu\",\"2-5\":\"2 a 5 pessoas\",\"6-20\":\"6 a 20 pessoas\",\"21+\":\"Mais de 20\"},\"objetivos\":{\"aparecer\":\"Aparecer no Google e no Maps\",\"contatos\":\"Mais contatos do site e dos anúncios\",\"responder\":\"Responder mais rápido no WhatsApp\",\"funil\":\"Organizar o funil e o CRM\",\"integrar\":\"Integrar os sistemas que já uso\",\"marca\":\"Rever a marca\"},\"estoque\":{\"ate-30\":\"Até 30 veículos\",\"31-80\":\"31 a 80\",\"81-150\":\"81 a 150\",\"151+\":\"Mais de 150\"},\"sistema\":{\"revenda-mais\":\"Revenda Mais\",\"autoconf\":\"Autoconf\",\"bndv\":\"BNDV\",\"boom\":\"Boom\",\"altimus\":\"Altimus\",\"syonet\":\"Syonet\",\"outro\":\"Outro\",\"nenhum\":\"Nenhum\"}};\nconst corpo = $input.first().json.body || {};\nconst lead = corpo.lead || {};\nconst origem = lead.origem || {};\nconst rotulo = (grupo, valor) => (valor ? ROTULOS[grupo][valor] || valor : \"\");\n\nconst whatsapp = String(lead.whatsapp || \"\").replace(/\\D/g, \"\");\nconst semPais = whatsapp.replace(/^55/, \"\");\nconst meio = semPais.length === 11 ? 7 : 6;\nconst whatsappLegivel = semPais ? \"(\" + semPais.slice(0, 2) + \") \" + semPais.slice(2, meio) + \"-\" + semPais.slice(meio) : \"\";\nconst primeiroNome = String(lead.nome || \"\").trim().split(/\\s+/)[0] || \"\";\nconst objetivos = (lead.objetivos || []).map((o) => rotulo(\"objetivos\", o));\n\nconst partesDaOrigem = [];\nif (origem.gclid || origem.gbraid || origem.wbraid) partesDaOrigem.push(\"Google Ads\");\nif (origem.fbclid) partesDaOrigem.push(\"Meta Ads\");\nif (origem.utm_source) partesDaOrigem.push(\"utm: \" + [origem.utm_source, origem.utm_medium, origem.utm_campaign].filter(Boolean).join(\" / \"));\nif (origem.referrer) partesDaOrigem.push(\"veio de \" + origem.referrer);\nif (origem.entrada) partesDaOrigem.push(\"entrou em \" + origem.entrada);\nconst origemResumo = partesDaOrigem.length ? partesDaOrigem.join(\" · \") : \"direta (sem parâmetro de campanha)\";\n\nconst linhasDoAviso = [\n  \"Novo pedido de diagnóstico pelo site\",\n  \"Nome: \" + lead.nome,\n  \"Empresa: \" + lead.empresa,\n  \"WhatsApp: \" + whatsappLegivel + \" (https://wa.me/\" + whatsapp + \")\",\n  \"E-mail: \" + lead.email,\n  \"Segmento: \" + rotulo(\"segmento\", lead.segmento) + (lead.porte ? \" · Porte: \" + rotulo(\"porte\", lead.porte) : \"\"),\n  objetivos.length ? \"Objetivos: \" + objetivos.join(\"; \") : \"\",\n  lead.estoque ? \"Estoque: \" + rotulo(\"estoque\", lead.estoque) + (lead.sistema ? \" · Sistema: \" + rotulo(\"sistema\", lead.sistema) : \"\") : \"\",\n  lead.mensagem ? \"Mensagem: \" + lead.mensagem : \"\",\n  \"Origem: \" + origemResumo,\n  lead.pagina ? \"Página: \" + lead.pagina : \"\",\n  \"Evento: \" + corpo.event_id,\n].filter(Boolean);\n\nconst respostaParaLead = [\n  \"Olá, \" + primeiroNome + \"! Aqui é a V2O5. Recebemos seu pedido de diagnóstico para a \" + lead.empresa + \".\",\n  \"O próximo passo é marcar os 45 minutos com o Dyones, fundador da V2O5. Que dia e horário ficam bons para você?\",\n  \"Depois da conversa, o mapa do que fazer primeiro chega em até 24 horas.\",\n].join(\"\\n\\n\");\n\nreturn [{\n  json: {\n    event_id: corpo.event_id,\n    recebido_em: corpo.recebido_em,\n    nome: lead.nome,\n    primeiroNome,\n    empresa: lead.empresa,\n    whatsapp,\n    whatsappInternacional: \"+\" + whatsapp,\n    whatsappLegivel,\n    email: lead.email,\n    segmento: rotulo(\"segmento\", lead.segmento),\n    porte: rotulo(\"porte\", lead.porte),\n    objetivos: objetivos.join(\"; \"),\n    estoque: rotulo(\"estoque\", lead.estoque),\n    sistema: rotulo(\"sistema\", lead.sistema),\n    mensagem: lead.mensagem || \"\",\n    pagina: lead.pagina || \"\",\n    origem,\n    origemResumo,\n    avisoParaDyones: linhasDoAviso.join(\"\\n\"),\n    respostaParaLead,\n  },\n}];"
      },
