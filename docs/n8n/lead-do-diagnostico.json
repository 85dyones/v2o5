    {
      "id": "ddc4b8fe-4457-5001-919f-ef9c149fd67f",
      "name": "Conversas para etiquetar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4560,
        300
      ],
      "parameters": {
        "jsCode": "// Depois da resposta ao lead, a Evolution abre (ou reaproveita) a conversa\n// na caixa do WhatsApp. Etiqueta as conversas abertas ou pendentes do\n// contato nessa caixa que ainda não têm a etiqueta da origem.\nconst cfg = $(\"Configuração\").first().json;\nif (!$(\"Contato marcado\").first().json.contatoId) return [];\nconst conversas = Array.isArray($input.first().json.payload) ? $input.first().json.payload : [];\nreturn conversas\n  .filter((c) => String(c.inbox_id) === String(cfg.chatwootInbox) && c.status !== \"resolved\")\n  .filter((c) => !(c.labels || []).includes(cfg.etiquetaOrigem))\n  .map((c) => ({ json: { conversaId: c.id, labels: [...new Set([...(c.labels || []), cfg.etiquetaOrigem])] } }));\n"
      }
    },
    {
      "id": "9005ef4b-5f59-5705-86c1-22cc1f204e23",
      "name": "Etiquetar conversa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4800,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuração').first().json.chatwootUrl }}/api/v1/accounts/{{ $('Configuração').first().json.chatwootConta }}/conversations/{{ $json.conversaId }}/labels",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ labels: $json.labels }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Chatwoot · api_access_token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "f9ea8884-4fae-511e-a207-19f31eb9644a",
      "name": "Conversa do lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4560,
        520
      ],
      "parameters": {
        "jsCode": "// O aviso do lead vai para o Dyones como nota privada na conversa que a\n// Evolution abriu ao responder: com a menção, o Chatwoot notifica no app e\n// por e-mail. Escolhe a conversa mais recente do contato na caixa do WhatsApp\n// que não está resolvida. Sem conversa (contato recusado, Evolution fora), o\n// aviso segue pelo WhatsApp, para o lead não se perder.\nconst cfg = $(\"Configuração\").first().json;\nconst aviso = $(\"Lead\").first().json.avisoParaDyones;\nconst mencao = \"[@\" + cfg.nomeDyones + \"](mention://user/\" + cfg.agenteDyones + \"/\" + encodeURIComponent(cfg.nomeDyones) + \")\";\nconst conversas = $(\"Contato marcado\").first().json.contatoId && Array.isArray($input.first().json.payload) ? $input.first().json.payload : [];\nconst conversa = conversas\n  .filter((c) => String(c.inbox_id) === String(cfg.chatwootInbox) && c.status !== \"resolved\")\n  .sort((a, b) => Number(b.id) - Number(a.id))[0];\nreturn [{ json: { conversaId: conversa ? conversa.id : null, nota: mencao + \" \" + aviso } }];\n"
      }
    },
    {
      "id": "d692e66d-7611-5391-b416-565868e46270",
      "name": "Achou a conversa?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        4800,
        520
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.conversaId }}",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
