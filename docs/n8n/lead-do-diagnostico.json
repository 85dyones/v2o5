    {
      "id": "c5ddbc5b-0dcd-56e5-a049-deaec6c50ab8",
      "name": "Telefone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "// O número como a Evolution o usa. No Brasil, o WhatsApp de muitos celulares\n// não tem o nono dígito: a Evolution grava o contato do Chatwoot com o número\n// dela (+55, DDD e 8 dígitos) e o identificador \"número@s.whatsapp.net\". O\n// contato que este fluxo marca tem de ser esse, ou a conversa abre num\n// contato sem marca e o agente não responde.\nconst digitado = String($(\"Lead\").first().json.whatsapp || \"\");\nconst respostas = $input.all().map((i) => i.json || {});\nconst achado = respostas.find((r) => r.exists === true && /^\\d+@s\\.whatsapp\\.net$/.test(String(r.jid || \"\")));\nconst numero = achado ? achado.jid.split(\"@\")[0] : digitado;\n\n// As duas grafias de um celular brasileiro, com e sem o nono dígito: é assim\n// que a própria Evolution procura o contato no Chatwoot.\nconst variantes = [numero];\nif (/^55\\d{2}9\\d{8}$/.test(numero)) variantes.push(numero.slice(0, 4) + numero.slice(5));\nif (/^55\\d{2}[6-9]\\d{7}$/.test(numero)) variantes.push(numero.slice(0, 4) + \"9\" + numero.slice(4));\n\nconst filtro = [];\nfor (const v of variantes) {\n  filtro.push({ attribute_key: \"identifier\", filter_operator: \"equal_to\", values: [v + \"@s.whatsapp.net\"], query_operator: \"OR\" });\n  filtro.push({ attribute_key: \"phone_number\", filter_operator: \"equal_to\", values: [\"+\" + v], query_operator: \"OR\" });\n}\nfiltro[filtro.length - 1].query_operator = null;\n\nreturn [{\n  json: {\n    numero,\n    telefone: \"+\" + numero,\n    identificador: achado ? achado.jid : null,\n    temWhatsApp: Boolean(achado),\n    variantes,\n    filtro,\n  },\n}];\n"
      }
    },
    {
      "id": "3a8c95a5-bef5-5596-8149-27f820413313",
