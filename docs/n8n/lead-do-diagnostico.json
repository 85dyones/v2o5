    {
      "id": "de24a71e-4719-5e33-b1c7-b6919d9042a1",
      "name": "Contato marcado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        300
      ],
      "parameters": {
        "jsCode": "// Junta os caminhos (atualizado, criado, criado sem e-mail) num id só.\nconst existente = $(\"Contato existente\").first().json.contatoId;\nconst p = $input.first().json.payload || {};\nconst gravado = (p.contact && p.contact.id) || p.id || null;\nreturn [{ json: { contatoId: existente || gravado } }];\n"
      }
    },
