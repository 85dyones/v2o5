    {
      "id": "81a280fe-ac67-5b55-89df-c9d457fe0d86",
      "name": "Contato existente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "jsCode": "// Escolhe o contato que a Evolution vai achar e monta o que gravar nele. A\n// marca de origem (atributo e etiqueta) entra aqui, antes de qualquer\n// mensagem ao lead: é ela que libera o agente de IA.\nconst cfg = $(\"Configuração\").first().json;\nconst lead = $(\"Lead\").first().json;\nconst tel = $(\"Telefone\").first().json;\nconst achados = Array.isArray($input.first().json.payload) ? $input.first().json.payload : [];\nconst contato =\n  achados.find((c) => tel.identificador && c.identifier === tel.identificador) ||\n  achados.find((c) => c.phone_number === tel.telefone) ||\n  achados[0] ||\n  null;\n\nconst atributos = {\n  [cfg.atributoOrigem]: cfg.valorOrigem,\n  entrada: \"formulário do diagnóstico\",\n  empresa: lead.empresa,\n  segmento: lead.segmento,\n  porte: lead.porte,\n  objetivos: lead.objetivos,\n  estoque: lead.estoque,\n  sistema: lead.sistema,\n  origem_da_visita: lead.origemResumo,\n  pagina: lead.pagina,\n  email_do_formulario: lead.email,\n  event_id: lead.event_id,\n  fonte: \"site v2o5.com.br\",\n};\n\n// Contato que já existe: o nome do formulário vale; e-mail, telefone e\n// identificador só entram se estiverem vazios (trocar o que existe pode\n// colidir com outro contato e derrubar a gravação inteira, marca junto).\nconst corpoAtualizar = { name: lead.nome, custom_attributes: atributos };\nif (contato && !contato.email && lead.email) corpoAtualizar.email = lead.email;\nif (contato && !contato.phone_number) corpoAtualizar.phone_number = tel.telefone;\nif (contato && !contato.identifier && tel.identificador) corpoAtualizar.identifier = tel.identificador;\n\nconst corpoCriarSemEmail = {\n  inbox_id: Number(cfg.chatwootInbox),\n  name: lead.nome,\n  phone_number: tel.telefone,\n  custom_attributes: atributos,\n};\nif (tel.identificador) corpoCriarSemEmail.identifier = tel.identificador;\nconst corpoCriar = lead.email ? { ...corpoCriarSemEmail, email: lead.email } : corpoCriarSemEmail;\n\nreturn [{ json: { contatoId: contato ? contato.id : null, corpoAtualizar, corpoCriar, corpoCriarSemEmail } }];\n"
      }
    },
