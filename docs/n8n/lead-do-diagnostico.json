      "name": "Somar etiqueta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3360,
        200
      ],
      "parameters": {
        "jsCode": "// A API troca a lista inteira de etiquetas: soma a da origem às que já existem.\nconst cfg = $(\"Configuração\").first().json;\nconst atuais = Array.isArray($input.first().json.payload) ? $input.first().json.payload : [];\nreturn [{ json: { labels: [...new Set([...atuais, cfg.etiquetaOrigem])] } }];\n"
